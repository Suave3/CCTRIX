# Flask
SECRET_KEY=change_this_to_a_random_string

# PostgreSQL Configuration
# Choose ONE of these options:

# OPTION 1: Local PostgreSQL (for development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_password_here
# DB_NAME=cctrix_db

# OPTION 2: Railway (for production deployment)
# DB_HOST=postgres.railway.internal
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_railway_password
# DB_NAME=railway

# OPTION 3: Docker PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=cctrix_password
# DB_NAME=cctrix_db

# OPTION 4: Neon (https://neon.tech)
# DB_HOST=your_neon_host.neon.tech
# DB_PORT=5432
# DB_USER=your_user
# DB_PASSWORD=your_password
# DB_NAME=your_database

# OPTION 5: Supabase (https://supabase.com)
# Get your connection string from Supabase and split it:
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your_supabase_password
# DB_NAME=postgres

# Select one configuration above and uncomment it
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=cctrix_db
DB_CONNECT_TIMEOUT=5

# Camera: 0 = webcam, or RTSP URL e.g. rtsp://192.168.1.100/stream
CAMERA_SOURCE=0

# Google reCAPTCHA v2 — register at https://www.google.com/recaptcha/admin
# Select "Challenge (v2) > I'm not a robot Checkbox", add your domain
RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET_KEY=your_secret_key_here

